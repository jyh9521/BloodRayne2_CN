+using GameVoicePlayFn = void(__thiscall*)(void*, const char*, float, void*, int);
+using GameBoxedCaptionFn = void(__thiscall*)(void*, const char*, float, float, int, int, int);
+GameVoicePlayFn g_original_game_voice_play = nullptr;
+GameBoxedCaptionFn g_game_boxed_caption = nullptr;
+HMODULE g_game_image = nullptr;
+
+const VoiceCaptionRow* FindVoiceCaption(const char* sound_name) {
+    if (sound_name == nullptr) return nullptr;
+    const char* slash = strrchr(sound_name, '\\');
+    const char* stem = slash != nullptr ? slash + 1 : sound_name;
+    const char* forward_slash = strrchr(stem, '/');
+    if (forward_slash != nullptr) stem = forward_slash + 1;
+    char normalized[64] = {};
+    const size_t stem_length = strcspn(stem, ".");
+    if (stem_length == 0 || stem_length >= sizeof(normalized)) return nullptr;
+    memcpy(normalized, stem, stem_length);
+    for (const auto& row : kVoiceCaptions) {
+        if (_stricmp(normalized, row.stem) == 0) return &row;
+    }
+    return nullptr;
+}
+
+void __fastcall RayneVoiceWithCaption(
+    void* actor, void*, const char* sound_name,
+    float sound_seconds, void* playback_context, int playback_flags) {
+    // Preserve the game voice call, its arguments, and its English sound path.
+    g_original_game_voice_play(
+        actor, sound_name, sound_seconds, playback_context, playback_flags);
+    const VoiceCaptionRow* row = FindVoiceCaption(sound_name);
+    if (row == nullptr || g_game_image == nullptr || g_game_boxed_caption == nullptr)
+        return;
+    auto* image = reinterpret_cast<unsigned char*>(g_game_image);
+    // This is the same global subtitle-enable check used by dbBoxedDisplay.
+    if (*reinterpret_cast<unsigned char*>(image + 0x5C3060C) == 0) return;
+    void* display = *reinterpret_cast<void**>(image + 0x3C07F8);
+    if (display == nullptr) return;
+    // Never overwrite a scripted/story caption; sequential engine voice
+    // cues may replace only captions installed from this same table.
+    if (*reinterpret_cast<const float*>(reinterpret_cast<const unsigned char*>(display) + 0x4F0) > 0.0f) {
+        const char* active = reinterpret_cast<const char*>(display) + 0x3F0;
+        bool own_caption = false;
+        for (const auto& candidate : kVoiceCaptions) {
+            if (strcmp(active, candidate.carrier) == 0) { own_caption = true; break; }
+        }
+        if (!own_caption) return;
+    }
+    g_game_boxed_caption(display, row->carrier, row->seconds, 1.0f, 0, 1, 1);
+}
