+bool PatchRayneVoiceCaptions(HMODULE image) {
+    // One call site in the engine voice selector (VA 00551F72). The
+    // selected WAV stem is already known here. Do not detour the shared
+    // sound engine, scripted dialogue, or any modded sound archive.
+    auto* base = reinterpret_cast<unsigned char*>(image);
+    auto* call = base + 0x151F72;
+    constexpr unsigned char expected[] = {0xE8, 0xD9, 0xC5, 0xEF, 0xFF};
+    if (memcmp(call, expected, sizeof(expected)) != 0) return false;
+    const auto old_voice = reinterpret_cast<GameVoicePlayFn>(base + 0x4E550);
+    const auto caption = reinterpret_cast<GameBoxedCaptionFn>(base + 0xF4560);
+    unsigned char replacement[5] = {0xE8, 0, 0, 0, 0};
+    const DWORD delta = static_cast<DWORD>(reinterpret_cast<ULONG_PTR>(&RayneVoiceWithCaption))
+        - static_cast<DWORD>(reinterpret_cast<ULONG_PTR>(call + 5));
+    memcpy(replacement + 1, &delta, sizeof(delta));
+    g_original_game_voice_play = old_voice;
+    g_game_boxed_caption = caption;
+    g_game_image = image;
+    if (!WriteProtectedMemory(call, replacement, sizeof(replacement))) {
+        g_original_game_voice_play = nullptr;
+        g_game_boxed_caption = nullptr;
+        g_game_image = nullptr;
+        return false;
+    }
+    return true;
+}
