+bool PatchBoundedLayoutTagScan(HMODULE image) {
+    // 005DE9F8: push "@@%[^@]@@%n".  Redirect only the format pointer;
+    // normal control tags retain their original grammar.
+    auto* base = reinterpret_cast<unsigned char*>(image);
+    auto* instruction = base + 0x1DE9F8;
+    constexpr unsigned char kExpected[] = {0x68, 0x48, 0x53, 0x71, 0x00};
+    if (memcmp(instruction, kExpected, sizeof(kExpected)) != 0) return false;
+    unsigned char replacement[5] = {0x68, 0, 0, 0, 0};
+    const DWORD address = static_cast<DWORD>(
+        reinterpret_cast<ULONG_PTR>(kBoundedLayoutTagScan));
+    memcpy(replacement + 1, &address, sizeof(address));
+    return WriteProtectedMemory(instruction, replacement, sizeof(replacement));
+}
