+            face.resize(static_cast<size_t>(count));
+            MultiByteToWideChar(
+                CP_ACP, 0, face_name, -1, face.data(), count);
+        }
+    }
+    return CreateFontW(
+        height,
+        width,
+        escapement,
+        orientation,
+        weight,
+        italic,
+        underline,
+        strike_out,
+        GB2312_CHARSET,
+        output_precision,
+        clip_precision,
+        quality,
+        pitch_and_family,
+        face.empty() ? L"Microsoft YaHei UI" : face.c_str());
+}
